name: Network Radar
desc: 在「第三方服务」分别显示本机直连和 Proxy 策略的出口、地区、延迟及检测时间。每十分钟在后台检测。

script-providers:
  proxyconfig-network-radar-worker-v2:
    url: https://raw.githubusercontent.com/SchweppesSoda/CustomRules/master/Stash/Scripts/network-radar.js?rev=20260721-v2
    interval: 86400
  proxyconfig-network-radar-direct-v3: &radar-exit-tile
    interval: 86400
    payload: |
      const direct = $argument === "direct";
      const tile = {
        title: direct ? "雷达 · 本机直连" : "雷达 · 本机代理",
        icon: direct ? "network" : "globe",
        content: "等待首次后台检测",
        backgroundColor: "#6b7280",
      };
      let state = {};
      try { state = JSON.parse($persistentStore.read("proxyconfig.network-radar.v1")) || {}; } catch {}
      const checkedAt = Number(state.checked_at);
      if (Number.isFinite(checkedAt) && checkedAt > 0) {
        const sample = direct ? state.direct : state.proxy;
        const clean = (value, limit) => typeof value === "string" ? value.replace(/\s+/g, " ").trim().slice(0, limit) : "";
        const ip = clean(sample?.ip, 45);
        const minutes = Math.max(0, Math.floor((Date.now() - checkedAt) / 60000));
        const age = minutes >= 1440 ? Math.floor(minutes / 1440) + " 天前" : minutes ? minutes + " 分钟前" : "刚刚";
        if (ip && !sample.error) {
          const latency = Number.isFinite(sample.ms) && sample.ms >= 0 ? Math.round(sample.ms) + " ms" : "";
          tile.content = [ip, clean(sample.country, 24), latency, age].filter(Boolean).join(" · ");
          tile.backgroundColor = direct ? "#18756a" : "#315ea8";
        } else {
          tile.content = "检测失败 · " + age;
          tile.backgroundColor = "#b45309";
        }
      }
      $done(tile);
  proxyconfig-network-radar-proxy-v3: *radar-exit-tile

cron:
  script:
    - name: proxyconfig-network-radar-worker-v2
      cron: '*/10 * * * *'
      timeout: 15
      argument: '{"mode":"refresh"}'

tiles:
  - name: proxyconfig-network-radar-direct-v3
    collapsed: true
    argument: direct
    interval: 600
    title: 雷达 · 本机直连
    content: 等待首次后台检测
    icon: network
    backgroundColor: '#6b7280'
  - name: proxyconfig-network-radar-proxy-v3
    collapsed: true
    argument: proxy
    interval: 600
    title: 雷达 · 本机代理
    content: 等待首次后台检测
    icon: globe
    backgroundColor: '#6b7280'
